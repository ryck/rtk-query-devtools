{
  "name": "rtk-query-devtools-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "pnpm --filter ./packages/core run dev",
    "dev:demo": "pnpm --filter demo run dev",
    "dev:web": "pnpm --filter web run dev",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean",
    "test": "vitest --project=unit",
    "test:ci": "vitest run --project=unit",
    "test:e2e": "playwright test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "changeset": "changeset",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "ncu": "pnpm dlx npm-check-updates --interactive --format group --cooldown 1d --workspaces --root"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7",
    "vitest": "^5.1.2",
    "turbo": "^2.11.13"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.23.0"
}
