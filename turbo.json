{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".vercel/output/**"],
      "env": ["VERCEL", "VERCEL_ENV", "NODE_ENV"]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true },
    "clean": { "cache": false }
  }
}
