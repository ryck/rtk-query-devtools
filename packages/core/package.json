{
  "name": "rtk-query-devtools",
  "version": "0.5.0",
  "description": "A TanStack DevTools plugin for inspecting RTK Query cache entries, mutations, tags, and requests in real time",
  "keywords": [
    "caching",
    "data-fetching",
    "devtools",
    "react",
    "redux",
    "redux-toolkit",
    "rtk-query",
    "tanstack",
    "tanstack-devtools"
  ],
  "homepage": "https://rtk-query-devtools.ryck.dev/",
  "bugs": {
    "url": "https://github.com/ryck/rtk-query-devtools/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryck/rtk-query-devtools.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./production": {
      "types": "./dist/production.d.ts",
      "import": "./dist/production.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@tanstack/devtools-utils": "^0.8.0",
    "@tanstack/match-sorter-utils": "^9.2.6",
    "@tanstack/react-virtual": "^3.14.28",
    "clsx": "^2.1.1",
    "lucide-react": "^1.81.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^8.0.0",
    "@reduxjs/toolkit": "^2.15.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "^0.10.15",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "@reduxjs/toolkit": ">=2.0.0",
    "@tanstack/react-devtools": ">=0.9.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-devtools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
